@model IEnumerable<Projekt_strona.Models.Car>

@{
    ViewData["Title"] = "Zarządzanie pojazdami";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="h3 mb-4 text-gray-800">Zarządzanie Pojazdami</h1>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Lista Samochodów</h6>
        <a href="/Admin/AddCar" class="btn btn-sm btn-success">
            <i class="fas fa-plus"></i> Dodaj Samochód
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th>Marka</th>
                        <th>Model</th>
                        <th>Rok</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in Model)
                    {
                        <tr>
                            <td>@car.Id</td>
                            <td>@car.Make</td>
                            <td>@car.Model</td>
                            <td>@car.Year</td>
                            <td>
                                <a href="/Admin/EditCustomer/@car.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit">edit</i>
                                </a>
                                <a href="/Admin/DeleteCustomer/@car.Id" class="btn btn-sm btn-danger ml-1">
                                    <i class="fas fa-trash-alt">delete</i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
